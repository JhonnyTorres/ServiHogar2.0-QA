{
  "name": "servihogar-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas automatizadas (Playwright) de ServiHogar 2.0 - Verificación y validación de software",
  "scripts": {
    "parche-web": "node aplicar-parche-web.mjs",
    "test": "playwright test",
    "test:sin-login": "playwright test --grep @sin-login",
    "test:con-login": "playwright test --grep @con-login",
    "reporte:html": "playwright show-report reporte/html",
    "reporte:md": "node scripts/generar-reporte.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
