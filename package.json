{
  "name": "servihogar-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas automatizadas (Playwright) de ServiHogar 2.0 - Verificación y validación de software",
  "scripts": {
    "parche-web": "node aplicar-parche-web.mjs",
    "test": "playwright test",
    "test:sin-cuenta": "playwright test --grep @sin-cuenta",
    "test:con-cuenta": "playwright test --grep @con-cuenta",
    "test:video": "cross-env PW_VIDEO=1 playwright test",
    "reporte:html": "playwright show-report reporte/html",
    "reporte:matriz": "node scripts/generar-matriz.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "dotenv": "^18.0.10",
    "typescript": "^5.6.0",
    "cross-env": "^7.0.3"
  }
}